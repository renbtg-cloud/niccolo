From 9065da9b803e0f5e923f371b18eac9d20c76f988 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 21 Nov 2026 03:14:08 +0000
Subject: [PATCH] WIP 01: explicit directed relation semantics

---
 .../src/pages/ExpertWorkbench.product.test.js | 10 +++++++-
 frontend/src/pages/ExpertWorkbenchPage.jsx    |  6 +++--
 frontend/src/state/expertWorkbench.js         | 23 +++++++++++++++++++
 3 files changed, 36 insertions(+), 3 deletions(-)

diff --git a/frontend/src/pages/ExpertWorkbench.product.test.js b/frontend/src/pages/ExpertWorkbench.product.test.js
index a5e8f12..bf9f937 100644
--- a/frontend/src/pages/ExpertWorkbench.product.test.js
+++ b/frontend/src/pages/ExpertWorkbench.product.test.js
@@ -1,7 +1,7 @@
 import { describe, expect, it } from 'vitest';
 import { readFileSync } from 'node:fs';
 import { NiccoloClient } from '../api/client.js';
-import { groundingRequest, nodeRequest, relationRequest } from '../state/expertWorkbench.js';
+import { groundingRequest, nodeRequest, relationRequest, relationSemantics } from '../state/expertWorkbench.js';
 
 const app = readFileSync(new URL('../App.jsx', import.meta.url), 'utf8');
 const page = readFileSync(new URL('./ExpertWorkbenchPage.jsx', import.meta.url), 'utf8');
@@ -46,6 +46,14 @@ describe('expert epistemic Workbench — structured MVP authoring', () => {
     });
   });
 
+  it('makes directed relation semantics explicit before the investigator selects endpoints', () => {
+    expect(relationSemantics.SUPERSEDES).toMatchObject({ left: 'Replacement object', right: 'Superseded object' });
+    expect(relationSemantics.CAUSES).toMatchObject({ left: 'Cause', right: 'Effect' });
+    expect(page).toContain('relationSemantics[relation.kind].description');
+    expect(page).toContain('relationSemantics[relation.kind].left');
+    expect(page).toContain('relationSemantics[relation.kind].right');
+  });
+
   it('keeps relation family semantics explicit instead of guessing them', () => {
     expect(() => relationRequest('CAUSAL', 'CONTRADICTS', 'a', 'b', 'R')).toThrow(/does not belong/);
     expect(relationRequest('SEMANTIC', 'CONTRADICTS', 'a', 'b', 'R').kind).toBe('CONTRADICTS');
diff --git a/frontend/src/pages/ExpertWorkbenchPage.jsx b/frontend/src/pages/ExpertWorkbenchPage.jsx
index d4fde94..bfffe9e 100644
--- a/frontend/src/pages/ExpertWorkbenchPage.jsx
+++ b/frontend/src/pages/ExpertWorkbenchPage.jsx
@@ -11,6 +11,7 @@ import {
   nodeRequest,
   relationKinds,
   relationRequest,
+  relationSemantics,
 } from '../state/expertWorkbench.js';
 
 function useWorkbenchMutation(client, workbenchQuery, fn) {
@@ -91,8 +92,9 @@ export function ExpertWorkbenchPage() {
         <h3>Add typed relation</h3>
         <label>Family<select value={relation.family} onChange={(e) => setRelation({ ...relation, family: e.target.value, kind: relationKinds[e.target.value][0] })}>{Object.keys(relationKinds).map((x) => <option key={x}>{x}</option>)}</select></label>
         <label>Relation<select value={relation.kind} onChange={(e) => setRelation({ ...relation, kind: e.target.value })}>{relationKinds[relation.family].map((x) => <option key={x}>{x}</option>)}</select></label>
-        <label>Left object<select value={relation.left} onChange={(e) => setRelation({ ...relation, left: e.target.value })}><option value="">Choose…</option>{data.nodes.map((n) => <option key={n.object_id} value={n.object_id}>{n.kind}: {n.text}</option>)}</select></label>
-        <label>Right object<select value={relation.right} onChange={(e) => setRelation({ ...relation, right: e.target.value })}><option value="">Choose…</option>{data.nodes.map((n) => <option key={n.object_id} value={n.object_id}>{n.kind}: {n.text}</option>)}</select></label>
+        <small className="relation-semantics">{relationSemantics[relation.kind].description}</small>
+        <label>{relationSemantics[relation.kind].left}<select value={relation.left} onChange={(e) => setRelation({ ...relation, left: e.target.value })}><option value="">Choose…</option>{data.nodes.map((n) => <option key={n.object_id} value={n.object_id}>{n.kind}: {n.text}</option>)}</select></label>
+        <label>{relationSemantics[relation.kind].right}<select value={relation.right} onChange={(e) => setRelation({ ...relation, right: e.target.value })}><option value="">Choose…</option>{data.nodes.map((n) => <option key={n.object_id} value={n.object_id}>{n.kind}: {n.text}</option>)}</select></label>
         <label>Rationale<textarea value={relation.rationale} maxLength={4096} onChange={(e) => setRelation({ ...relation, rationale: e.target.value })} /></label>
         <button disabled={busy}>Create relation</button>
       </form>
diff --git a/frontend/src/state/expertWorkbench.js b/frontend/src/state/expertWorkbench.js
index 840e44d..60db9b0 100644
--- a/frontend/src/state/expertWorkbench.js
+++ b/frontend/src/state/expertWorkbench.js
@@ -5,6 +5,29 @@ export const relationKinds = Object.freeze({
   CAUSAL: ['CAUSES', 'CONTRIBUTES_TO', 'ENABLES', 'PREVENTS', 'INTENSIFIES', 'ATTENUATES'],
 });
 
+
+export const relationSemantics = Object.freeze({
+  EQUIVALENT_TO: { left: 'Object A', right: 'Object B', description: 'The two objects express equivalent meaning in this context.' },
+  MORE_SPECIFIC_THAN: { left: 'More specific object', right: 'Broader object', description: 'The left object narrows the meaning of the right object.' },
+  ENTAILS: { left: 'Entailing object', right: 'Entailed object', description: 'Accepting the left object commits the model to the right object under the stated rationale.' },
+  CONTRADICTS: { left: 'Object A', right: 'Object B', description: 'The two objects cannot both hold as stated in the same relevant context.' },
+  PARTIAL_OVERLAP: { left: 'Object A', right: 'Object B', description: 'The objects overlap semantically without being equivalent.' },
+  REFINES: { left: 'Refined object', right: 'Prior object', description: 'The left object adds precision to the right object without necessarily replacing it.' },
+  SUPERSEDES: { left: 'Replacement object', right: 'Superseded object', description: 'The left object replaces the right object for subsequent reasoning.' },
+  RETRACTS: { left: 'Retraction object', right: 'Retracted object', description: 'The left object explicitly withdraws the right object from active use.' },
+  CONSOLIDATES: { left: 'Consolidated object', right: 'Source object', description: 'The left object incorporates the right object into a consolidated representation.' },
+  SEPARATES: { left: 'Separated object', right: 'Prior combined object', description: 'The left object separates a distinction that the right object previously combined.' },
+  REINTERPRETS: { left: 'New interpretation', right: 'Prior object', description: 'The left object provides a revised reading of the right object.' },
+  RELEVANT_TO: { left: 'Relevant object', right: 'Context object', description: 'The left object is relevant to the right object in the stated context.' },
+  APPLICABLE_UNDER: { left: 'Applicable object', right: 'Condition object', description: 'The left object applies under the condition represented by the right object.' },
+  CAUSES: { left: 'Cause', right: 'Effect', description: 'The left object is asserted as a cause of the right object.' },
+  CONTRIBUTES_TO: { left: 'Contributor', right: 'Outcome', description: 'The left object contributes causally to the right object without claiming sole causation.' },
+  ENABLES: { left: 'Enabler', right: 'Enabled outcome', description: 'The left object enables the right object.' },
+  PREVENTS: { left: 'Preventer', right: 'Prevented outcome', description: 'The left object prevents the right object.' },
+  INTENSIFIES: { left: 'Intensifier', right: 'Affected outcome', description: 'The left object increases the intensity or likelihood represented by the right object.' },
+  ATTENUATES: { left: 'Attenuator', right: 'Affected outcome', description: 'The left object reduces the intensity or likelihood represented by the right object.' },
+});
+
 export const nodeKinds = Object.freeze(['PROPOSITION', 'HYPOTHESIS', 'ASSUMPTION', 'INFORMATION_GAP', 'FINDING']);
 export const argumentModes = Object.freeze(['DEDUCTIVE', 'INDUCTIVE', 'ABDUCTIVE', 'CAUSAL', 'ANALOGICAL', 'POLICY', 'OTHER']);
 export const groundingEffects = Object.freeze(['SUPPORTS', 'WEAKENS', 'CHALLENGES', 'CONDITIONS']);
-- 
2.47.3
