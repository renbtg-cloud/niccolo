 #[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
 pub struct WorkbenchSnapshot {
     pub situation_id: Uuid,
@@ -307,10 +326,12 @@ pub struct WorkbenchSnapshot {
     pub relations: Vec<ExpertRelation>,
